{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Portfolio (Web + API)",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Preview Portfolio Build",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"preview",
				"--workspace",
				"@mubarek/web"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}